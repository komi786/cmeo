}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000030",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A measurement datum that documents a quantitative or ordinal assessment of a quality of an entity (typically a patient), obtained by applying a measurement procedure and recorded as a result value with an associated unit or scale when applicable."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#id" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000030"
  } ],
  "http://www.geneontology.org/formats/oboInOwl#inSubset" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000085"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Differs from IAO:0000109 'measurement datum', which covers any recorded output of a measurement; this class restricts it to data about a quality of an entity, typically a patient."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://purl.obolibrary.org/obo/cmeo.owl"
  } ],
