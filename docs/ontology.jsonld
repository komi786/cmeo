  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A device that is designed to be worn on, or attached to, the body of a person and that senses, records, or transmits data about the wearer's physiological, behavioral, or environmental state, continuously or intermittently."
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000116" : [ {
    "@language" : "en",
    "@value" : "\"Requested for inclusion in OBI; to be replaced by the OBI term once released.\""
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000118" : [ {
    "@language" : "en",
    "@value" : "health wearable"
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000233" : [ {
    "@id" : "https://github.com/obi-ontology/obi/issues/2014"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "wearable device"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@language" : "en",
    "@value" : "https://saref.etsi.org/saref4wear/v2.1.1/WearableDevice"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/COB_0001300"
  } ],
