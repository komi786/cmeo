  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A data entity that documents a characteristic of a patient, such as a demographic attribute, lifestyle factor, risk factor or treatment adherence, obtained through observation, examination or reporting, and that is not a diagnosis, procedure or medication exposure."
  } ],
  "http://purl.obolibrary.org/obo/OBI_9991118" : [ {
