    "@language" : "en",
    "@value" : "For a weight data element, a missing value specification might state that the code \"-9\" in the dataset means the weight was not measured."
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A value specification that specifies the value or code used in a dataset to indicate that the value of a data element is missing, not recorded, or not applicable (e.g., \"NA\", \"-9\", or an empty string)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
