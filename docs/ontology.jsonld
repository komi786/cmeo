  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A process consisting of an interaction between a patient and one or more healthcare providers for the purpose of assessing, monitoring, or managing the patient's health, occurring at a point in time or over a time interval."
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000117" : [ {
    "@language" : "en",
    "@value" : "medical visit"
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000412" : [ {
    "@language" : "en",
    "@value" : "http://purl.obolibrary.org/obo/NCIT_C154624"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://purl.obolibrary.org/obo/cmeo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "medical encounter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/BFO_0000015"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000007",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A planned process that links a concept to a unique identifier in the respective domain standard (for example, linking the variable 'bp' to the blood pressure concept in SNOMED)."
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000118" : [ {
    "@language" : "en",
    "@value" : "data standardization"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://purl.obolibrary.org/obo/cmeo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "data mapping"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/COB_0000035"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000008",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "An information content entity that specifies a mathematical or logical expression used to compute a derived value from one or more input variables, parameters, or constants."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasExactSynonym" : [ {
    "@language" : "en",
    "@value" : "formula"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://purl.obolibrary.org/obo/cmeo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "variable derivation formula"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000030"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000009",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A basic unit of information that has a unique meaning and instances (data items) of distinct value. Examples of data elements include gender, race, and geographic location in data dictionary(ref. https://cde.nlm.nih.gov/). It provides classification of data elements"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A grouping or label that provides a semantic interpretation of a data element."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://purl.obolibrary.org/obo/cmeo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "data element"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000027"
  }, {
    "@id" : "_:genid1"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000010",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "An information content entity (a data item, e.g. a variable or record) that documents the occurrence of a clinically relevant event for a patient at a point in time or over a time interval (e.g., a death, a hospitalization, a myocardial infarction), and that is about the corresponding real-world process."
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000116" : [ {
    "@language" : "en",
    "@value" : "CMEO mints the information/record layer, not the occurrent. This class is the record or variable about the event; it 'is about' (IAO:0000136) the underlying process (BFO:0000015). The real-world occurrence itself is not minted in CMEO but referenced via 'is about' and, where relevant, cross-referenced to process ontologies (e.g. OAE for adverse events)."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasExactSynonym" : [ {
    "@language" : "en",
    "@value" : "clinical event"
  } ],
  "http://www.geneontology.org/formats/oboInOwl#inSubset" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000085"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://purl.obolibrary.org/obo/cmeo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "clinical event record"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000027"
  }, {
    "@id" : "_:genid2"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000011",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A clinical event record that documents an occurrence of bleeding in a patient  -  the loss of blood from the circulatory system to an external site or into tissues or body cavities  -  at a specified time point or during a specified time interval."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasExactSynonym" : [ {
    "@language" : "en",
    "@value" : "bleeding event"
  } ],
  "http://www.geneontology.org/formats/oboInOwl#inSubset" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000085"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@language" : "en",
    "@value" : "https://w3id.org/CMEO"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "bleeding event record"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000010"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000012",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A clinical event record that documents an occurrence involving the heart or blood vessels in a patient at a specified time point or during a specified time interval, typically an acute episode or outcome relevant to cardiovascular health."
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000116" : [ {
    "@language" : "en",
    "@value" : "Use for outcome/event variables such as myocardial infarction, stroke, heart failure hospitalization, cardiac arrest, revascularization events, cardiovascular death, or composite endpoints (e.g., MACE) when represented as occurrences. Do not use for chronic diagnoses recorded as ongoing states (classify those as condition), nor for procedures or medication exposures unless the dataset encodes them explicitly as events.\n\nIf you want a clean child hierarchy under this class, common subclasses are:\n\nmyocardial infarction event\nstroke event\nheart failure hospitalization event\nrevascularization event\ncardiovascular death event\nmajor adverse cardiovascular event (composite)"
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasExactSynonym" : [ {
    "@language" : "en",
    "@value" : "cardiovascular event"
  } ],
  "http://www.geneontology.org/formats/oboInOwl#inSubset" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000085"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@language" : "en",
    "@value" : "https://w3id.org/CMEO"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "cardiovascular event record"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@language" : "en",
    "@value" : "http://snomed.info/id/405617006"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000010"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000013",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A clinical event record  that documents an untoward or harmful occurrence in a patient following a medical intervention (such as the administration of a drug, a procedure, or the use of a medical device), whether or not judged to be caused by it, and that is about the corresponding adverse-event process."
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000116" : [ {
    "@language" : "en",
    "@value" : "Modelled in CMEO as an information/record layer term, not the occurrent itself. It 'is about' the underlying process (inherited from 'clinical event') and is cross-referenced via skos:exactMatch to OAE:0000001 'adverse event'. CMEO keeps its own IRI because it is used as an event/outcome descriptor in the metadata scope rather than imported as an OAE pathological process."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasExactSynonym" : [ {
    "@language" : "en",
    "@value" : "adverse event"
  } ],
  "http://www.geneontology.org/formats/oboInOwl#inSubset" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000085"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://purl.obolibrary.org/obo/cmeo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "adverse event record"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000010"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid3"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://purl.obolibrary.org/obo/OAE_0000001"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000014",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "An adverse event record that documents an adverse event following, and associated with, the administration of a drug or biological product to a patient."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasExactSynonym" : [ {
    "@language" : "en",
    "@value" : "adverse drug event"
  } ],
  "http://www.geneontology.org/formats/oboInOwl#inSubset" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000085"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://purl.obolibrary.org/obo/cmeo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "adverse drug event record"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000013"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid7"
  } ],
  "http://www.w3.org/2004/02/skos/core#exactMatch" : [ {
    "@id" : "http://purl.obolibrary.org/obo/OAE_0000005"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000015",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "An adverse event record that documents a hypersensitivity reaction of the immune system occurring following exposure to an allergen such as a drug, food, or environmental substance."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasExactSynonym" : [ {
    "@language" : "en",
    "@value" : "allergic reaction"
  } ],
  "http://www.geneontology.org/formats/oboInOwl#inSubset" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000085"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@language" : "en",
    "@value" : "https://w3id.org/CMEO"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "allergic reaction record"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@language" : "en",
    "@value" : "http://purl.obolibrary.org/obo/NCIT_C53782"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000013"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid11"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000016",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "An adverse event record that documents an event caused by, or associated with, the use of a medical device, where there is a causal relation between the event and the use of that device."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasExactSynonym" : [ {
    "@language" : "en",
    "@value" : "device adverse event"
  } ],
  "http://www.geneontology.org/formats/oboInOwl#inSubset" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000085"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@language" : "en",
    "@value" : "https://w3id.org/CMEO"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "device adverse event record"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@language" : "en",
    "@value" : "http://purl.obolibrary.org/obo/OAE_0000096"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000013"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid15"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000017",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A clinical event record that documents the death of a patient, occurring at a specified time point or during a specified time interval."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasExactSynonym" : [ {
    "@language" : "en",
    "@value" : "death"
  } ],
  "http://www.geneontology.org/formats/oboInOwl#inSubset" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000085"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://purl.obolibrary.org/obo/cmeo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "death record"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@language" : "en",
    "@value" : "http://snomed.info/id/419620001"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000010"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000018",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A mortality outcome record that documents the counts or indicates death occurring in a study population regardless of the underlying cause of death."
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000116" : [ {
    "@language" : "en",
    "@value" : "Use for endpoints such as \"death (any cause)\", \"all-cause death\", \"time to death\", or \"vital status\". Do not restrict by etiology; any death event qualifies."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#inSubset" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000085"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@language" : "en",
    "@value" : "https://w3id.org/CMEO"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "all-cause mortality"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000017"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000019",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A mortality outcome record that documents the counts or indicates death occurring in a study population where the death is attributed to a specified cause category (e.g., cardiovascular, cancer, infection) according to a defined attribution method."
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000116" : [ {
    "@language" : "en",
    "@value" : "Use when the dataset provides a cause-of-death classification (e.g., \"cardiovascular death\"). Record the cause category as an explicit attribute/value (or link) and, where available, note the attribution method (death certificate, adjudication committee, ICD coding). If cause is unknown/undetermined, do not treat it as cause-specific mortality."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#inSubset" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000085"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@language" : "en",
    "@value" : "https://w3id.org/CMEO"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "cause-specific mortality"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000017"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000021",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A clinical event record that documents an inpatient hospital encounter in which a patient is admitted to a hospital for care (typically characterized by an admission and a discharge), and that is about the corresponding medical encounter process."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#hasExactSynonym" : [ {
    "@language" : "en",
    "@value" : "hospitalization"
  } ],
  "http://www.geneontology.org/formats/oboInOwl#inSubset" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000085"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://purl.obolibrary.org/obo/cmeo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hospitalization record"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000010"
  }, {
    "@id" : "_:genid19"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000026",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A symbol (a string of characters) that is assigned to a concept within a standardized terminology or classification system (e.g., a SNOMED CT or LOINC code) in order to identify and denote that concept."
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000116" : [ {
    "@language" : "en",
    "@value" : "Distinct from 'centrally registered identifier' (IAO:0000578): a code identifies/denotes a concept (a universal) in a terminology, not a particular registered in a central registry."
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000118" : [ {
    "@language" : "en",
    "@value" : "Concept"
  } ],
  "http://purl.obolibrary.org/obo/IAO_0006011" : [ {
