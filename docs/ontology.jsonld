    "@language" : "en",
    "@value" : "retrospective study design"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/OBI_0500000"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000068",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000231" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000227"
  } ],
  "http://purl.obolibrary.org/obo/IAO_0100001" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CTO_0000033"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Obsoleted in response to OBO Foundry review (OBOFoundry.github.io#2822): duplicate of an existing OBO term. Use the replacement term."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "obsolete healthy volunteer criterion"
  } ],
  "http://www.w3.org/2002/07/owl#deprecated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000069",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "An exclusion criterion that defines a condition under which a participant is ineligible for a study because they have a history of a specified surgical procedure occurring before a defined reference time point, optionally within a specified look-back period."
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000116" : [ {
    "@language" : "en",
    "@value" : "\"Requested for inclusion in OBI; to be replaced by the OBI term once released.\""
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000233" : [ {
    "@id" : "https://github.com/obi-ontology/obi/issues/2014"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/cmeo#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "surgical procedure history exclusion criterion"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/OBI_0500028"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000070",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "An exclusion criterion that defines a condition under which a participant is ineligible for a study because they have had, currently have, or are expected to have a specified clinical exposure within a defined time frame."
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000116" : [ {
    "@value" : "\"Requested for inclusion in OBI; to be replaced by the OBI term once released.\""
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000233" : [ {
    "@id" : "https://github.com/obi-ontology/obi/issues/2014"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/cmeo#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "clinical exposure exclusion criterion"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/OBI_0500028"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000071",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "It refers to a benchmark or reference against which the effects of a medical intervention are compared. In clinical trials, the comparator can be a placebo (an inactive substance designed to resemble the drug being tested), a different dose or regimen of the drug being studied, or a different drug altogether. The choice of comparator is a critical aspect of clinical trial design and can significantly impact the interpretation and applicability of the trial's results."
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@language" : "en",
    "@value" : "https://viares.com/blog/clinical-research-explained/comparator/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://purl.obolibrary.org/obo/cmeo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "comparator specification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000033"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000072",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@value" : "In clinical studies, Intervention specification involves a detailed, precise, and a priori definition of the treatment, procedure, or behavioral regimen being tested to ensure reproducibility, accurate implementation, and valid evaluation of outcomes"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@language" : "en",
    "@value" : "https://www.ncbi.nlm.nih.gov/books/NBK305500/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://purl.obolibrary.org/obo/cmeo.owl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "intervention specification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000033"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000073",
