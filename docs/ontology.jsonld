    "@id" : "http://purl.obolibrary.org/obo/BMONT_0000079"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000003",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A wearable device that is worn on the body, or embedded in a wearable item, and that detects and records one or more physiological, behavioral, or environmental properties of a person over time."
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000116" : [ {
    "@language" : "en",
    "@value" : "\"Requested for inclusion in OBI; to be replaced by the OBI term once released.\""
  } ],
