}, {
  "@id" : "http://purl.obolibrary.org/obo/CMEO_0000033",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A blood measurement record that documents the quantification of a biomarker, i.e., an analyte measured in a blood-derived specimen (whole blood, plasma, or serum) and used to indicate a biological state, physiological process, or pathological process (e.g., troponin, HbA1c, creatinine, CRP)."
  } ],
  "http://www.geneontology.org/formats/oboInOwl#inSubset" : [ {
    "@id" : "http://purl.obolibrary.org/obo/CMEO_0000085"
  } ],
