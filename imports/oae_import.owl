        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000066"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002405"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OAE_0001788"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OAE_0001836"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OAE_0001837"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OAE_0001838"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OAE_0001839"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OAE_0001840"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>an AE that occurs in immune system.</obo:IAO_0000115>
        <obo:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;immune system disorder&apos; was mentioned in 292 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo:IAO_0000116>
        <obo:IAO_0000117>YH</obo:IAO_0000117>
        <obo:IAO_0000118>immune system disorder AE</obo:IAO_0000118>
        <rdfs:label>immune system AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002715</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0021053</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000568 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000568">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000584"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OAE_0001788"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OAE_0001836"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OAE_0001837"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OAE_0001838"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OAE_0001839"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OAE_0001840"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">a hypersensitivity AE which results in an allergic response showing a marked increase in reactivity to an antigen upon subsequent exposure.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>allergic reaction AE</obo:IAO_0000118>
        <obo:IAO_0000118>allergic response AE</obo:IAO_0000118>
        <obo:IAO_0000118>anaphylactic reaction AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Allergy</obo:IAO_0000119>
        <obo:OAE_0001849>变态反应</obo:OAE_0001849>
        <obo:OAE_0001849>过敏反应</obo:OAE_0001849>
        <obo:OAE_0004334>10001718</obo:OAE_0004334>
        <obo:OAE_0004334>10001738</obo:OAE_0004334>
        <rdfs:label>allergy AE</rdfs:label>
        <rdfs:seeAlso>CTCAE: E11248</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0001878</rdfs:seeAlso>
        <rdfs:seeAlso>NCIt: C3114</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000584 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000584">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <obo:IAO_0000115>Hypersensitivity AE is a immune system AE that is a set of undesirable reactions produced by the normal immune system, including allergies and autoimmunity. These reactions may be damaging, uncomfortable, or occasionally fatal.</obo:IAO_0000115>
        <obo:IAO_0000117>JX, LW, YH</obo:IAO_0000117>
        <obo:IAO_0000118>hypersensitivity reaction AE</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hypersensitivity</obo:IAO_0000119>
        <obo:OAE_0001849>超敏反应</obo:OAE_0001849>
        <obo:OAE_0004334>10020751</obo:OAE_0004334>
        <rdfs:label>hypersensitivity AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0100326</rdfs:seeAlso>
