        <rdfs:comment>Note the AE severity Grade 4 equals to CTCAE G4 AE severity.</rdfs:comment>
        <rdfs:label xml:lang="en">AE severity G4</rdfs:label>
        <rdfs:seeAlso>CTCAE4: E10008 (Grade 4 Adverse Event)</rdfs:seeAlso>
    </owl:Class>
    


