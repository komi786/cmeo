    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/identifier -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/identifier"/>
    


    <!-- http://purl.org/dc/terms/alternative -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/alternative"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://semanticscience.org/resource/equivalentTo -->

    <owl:AnnotationProperty rdf:about="http://semanticscience.org/resource/equivalentTo"/>
    


    <!-- http://semanticscience.org/resource/subset -->

    <owl:AnnotationProperty rdf:about="http://semanticscience.org/resource/subset"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#example -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#example"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://semanticscience.org/resource/SIO_000001 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000001">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://semanticscience.org/resource/SIO_000000"/>
        <rdfs:range rdf:resource="http://semanticscience.org/resource/SIO_000000"/>
        <dc:identifier>SIO_000001</dc:identifier>
        <terms:description xml:lang="en">A is related to B iff there is some relation between A and B.</terms:description>
        <resource:subset>core</resource:subset>
        <resource:subset>relations+</resource:subset>
        <rdfs:comment>&apos;is related to&apos; is the top level relation in SIO</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is related to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000008 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000008">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000001"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000011"/>
        <rdfs:domain rdf:resource="http://semanticscience.org/resource/SIO_000000"/>
        <dc:identifier>SIO_000008</dc:identifier>
        <terms:description xml:lang="en">has attribute is a relation that associates a entity with an attribute where an attribute is an intrinsic characteristic such as a quality, capability, disposition, function, or is an externally derived attribute determined from some descriptor (e.g. a quantity, position, label/identifier) either directly or indirectly through generalization of entities of the same type.</terms:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has attribute</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000011 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000011">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000001"/>
        <dc:identifier>SIO_000011</dc:identifier>
        <terms:description xml:lang="en">is attribute of is a relation that associates an attribute with an entity where an attribute is an intrinsic characteristic such as a quality, capability, disposition, function, or is an externally derived attribute determined from some descriptor (e.g. a quantity, position, label/identifier) either directly or indirectly through generalization of entities of the same type.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is attribute of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000028 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000028">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000145"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000068"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ReflexiveProperty"/>
        <dc:identifier>SIO_000028</dc:identifier>
        <terms:description xml:lang="en">has part is a transitive, reflexive and antisymmetric relation between a whole and itself or a whole and its part.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has part</rdfs:label>
        <skos:example xml:lang="en">a collection of cars has as a car as a part;a car has an engine as a part; a car has a piston as a part;</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000053 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000053">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000028"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000093"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <dc:identifier>SIO_000053</dc:identifier>
        <terms:description xml:lang="en">has proper part is an antisymmetric, irreflexive (normally transitive) relation between a whole and a distinct part.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has proper part</rdfs:label>
        <skos:example xml:lang="en">a car has an engine as a proper part; a car has a piston as a proper part;</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000061 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000061">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000322"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000145"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <dc:identifier>SIO_000061</dc:identifier>
        <terms:description xml:lang="en">A is located in B iff the spatialtemporial region occupied by A is part of the spatialtemporal region occupied by B. [T][R]</terms:description>
        <resource:equivalentTo>OBO_REL:located_in</resource:equivalentTo>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is located in</rdfs:label>
        <skos:example xml:lang="en">A parasite in the interior of a person&apos;s intestine is located in their intestinal lumen.</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000068 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000068">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000061"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ReflexiveProperty"/>
        <dc:identifier>SIO_000068</dc:identifier>
        <terms:description xml:lang="en">is part of is a transitive, reflexive and anti-symmetric mereological relation between a whole and itself or a part and its whole.</terms:description>
        <resource:equivalentTo>OBO_REL:part_of</resource:equivalentTo>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000093 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000093">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000068"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <dc:identifier>SIO_000093</dc:identifier>
        <terms:description xml:lang="en">is proper part of is an asymmetric, irreflexive (normally transitive) relation between a part and its distinct whole.</terms:description>
        <resource:equivalentTo>OBO_REL:proper_part_of</resource:equivalentTo>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is proper part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000145 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000145">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000322"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <dc:identifier>SIO_000145</dc:identifier>
        <terms:description xml:lang="en">A is location of B iff the spatialtemporal region occupied by A has the spatialtemporal region occupied by B as a part. [T][R]</terms:description>
        <resource:subset>nlp+</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is location of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000215 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000215">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000011"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000216"/>
        <rdfs:domain rdf:resource="http://semanticscience.org/resource/SIO_000070"/>
        <dc:identifier>SIO_000215</dc:identifier>
        <terms:description xml:lang="en">is measurement value of is a relation between a value and the entity that it is a measurement of.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is measurement value of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000216 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000216">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000008"/>
        <rdfs:range rdf:resource="http://semanticscience.org/resource/SIO_000070"/>
        <dc:identifier>SIO_000216</dc:identifier>
        <terms:description xml:lang="en">has measurement value is a relation between a quality/realizable and a measurement value.</terms:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has measurement value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000217 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000217">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000223"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000218"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:range rdf:resource="http://semanticscience.org/resource/SIO_000005"/>
        <dc:identifier>SIO_000217</dc:identifier>
        <terms:description xml:lang="en">has quality is a relation between an entity and the quality that it bears.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has quality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000218 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000218">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000224"/>
        <rdfs:domain rdf:resource="http://semanticscience.org/resource/SIO_000005"/>
        <dc:identifier>SIO_000218</dc:identifier>
        <terms:description xml:lang="en">is quality of is a relation between a quality and the entity that it is a property of.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is quality of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000221 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000221">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000008"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000222"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://semanticscience.org/resource/SIO_000075"/>
        <rdfs:range rdf:resource="http://semanticscience.org/resource/SIO_000074"/>
        <dc:identifier>SIO_000221</dc:identifier>
        <terms:description xml:lang="en">has unit is a relation between a quantity and the unit it is a multiple of.</terms:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000222 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000222">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000011"/>
        <rdfs:domain rdf:resource="http://semanticscience.org/resource/SIO_000074"/>
        <dc:identifier>SIO_000222</dc:identifier>
        <terms:description xml:lang="en">is unit of is a relation between a unit and a quantity that it is a multiple of.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is unit of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000223 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000223">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000008"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000224"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <dc:identifier>SIO_000223</dc:identifier>
        <terms:description xml:lang="en">has property is a relation between an entity and the quality, capability or role that it and it alone bears.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has property</rdfs:label>
        <skos:example xml:lang="en">michel&apos;s hair has the quality of being brown in colour.</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000224 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000224">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000011"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <dc:identifier>SIO_000224</dc:identifier>
        <terms:description xml:lang="en">is property of is a relation betweena  quality, capability or role and the entity that it and it alone bears.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is property of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000254 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000254">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000011"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000255"/>
        <rdfs:domain rdf:resource="http://semanticscience.org/resource/SIO_000078"/>
        <dc:identifier>SIO_000254</dc:identifier>
        <terms:description xml:lang="en">is annotation of is a relation between some textual entity and the entity that it annotates.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is annotation of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000255 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000255">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000008"/>
        <rdfs:range rdf:resource="http://semanticscience.org/resource/SIO_000078"/>
        <dc:identifier>SIO_000255</dc:identifier>
        <terms:alternative xml:lang="en">is annotated with</terms:alternative>
        <terms:alternative xml:lang="en">was annotated with</terms:alternative>
        <terms:description xml:lang="en">has annotation is a relation between an entity and some textual anntotation.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has annotation</rdfs:label>
        <skos:example xml:lang="en">document x is annotated with the keywords &apos;ontology&apos;,&apos;semantic web&apos;</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000273 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000273">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000053"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000310"/>
        <dc:identifier>SIO_000273</dc:identifier>
        <terms:description xml:lang="en">has direct part is a relation to specify a part at a particular level of granularity</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has direct part</rdfs:label>
        <skos:example xml:lang="en">a car has an engine as a direct part</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000310 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000310">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000093"/>
        <dc:identifier>SIO_000310</dc:identifier>
        <terms:description xml:lang="en">is direct part of is a relation between a specific part (at some level of granularity) and its whole.</terms:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is direct part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000322 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000322">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000001"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <dc:identifier>SIO_000322</dc:identifier>
        <terms:description xml:lang="en">A is spatiotemporally related to B iff A is in the spatial or temporal vicinity of B</terms:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is spatiotemporally related to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000325 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000325">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000322"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ReflexiveProperty"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000325"/>
            <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000068"/>
        </owl:propertyChainAxiom>
        <dc:identifier>SIO_000325</dc:identifier>
        <terms:description xml:lang="en">A overlaps with B iff there is some C that is part of both A and B. [S][R]</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">overlaps with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000643 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000643">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000224"/>
        <owl:inverseOf rdf:resource="http://semanticscience.org/resource/SIO_000644"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <dc:identifier>SIO_000643</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">is realizable property of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000644 -->

    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000644">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000223"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <dc:identifier>SIO_000644</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has realizable property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://semanticscience.org/resource/SIO_000300 -->

    <owl:DatatypeProperty rdf:about="http://semanticscience.org/resource/SIO_000300">
        <dc:identifier>SIO_000300</dc:identifier>
        <terms:description xml:lang="en">A relation between a informational entity and its actual value (numeric, date, text, etc).</terms:description>
        <resource:subset>core</resource:subset>
        <resource:subset>nlp</resource:subset>
        <resource:subset>relations</resource:subset>
        <resource:subset xml:lang="en">sadi</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">has value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
