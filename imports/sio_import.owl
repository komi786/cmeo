<?xml version="1.0"?>
<rdf:RDF xmlns="http://purl.obolibrary.org/obo/cmeo/imports/sio_import.owl#"
     xml:base="http://purl.obolibrary.org/obo/cmeo/imports/sio_import.owl"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:resource="http://semanticscience.org/resource/">
    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/cmeo/imports/sio_import.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/cmeo/imports/sio_import.owl"/>
    </owl:Ontology>
    


    <!-- 
