    <!-- http://semanticscience.org/resource/SIO_000000 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000000">
        <dc:identifier>SIO_000000</dc:identifier>
        <terms:description xml:lang="en">Every thing is an entity.</terms:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">entity</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000005 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000005">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000614"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000218"/>
                <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/SIO_000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://semanticscience.org/resource/SIO_000340"/>
        <dc:identifier>SIO_000005</dc:identifier>
        <terms:description xml:lang="en">A quality is an attribute that is intrinsically associated with its bearer (or its parts), but whose presence/absence and observed/measured value may vary.</terms:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">quality</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000006 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000006">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000053"/>
                <owl:allValuesFrom rdf:resource="http://semanticscience.org/resource/SIO_000006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>SIO_000006</dc:identifier>
        <terms:description xml:lang="en">A process is an entity that is identifiable only through the unfolding of time, has temporal parts, and unless otherwise specified/predicted, cannot be identified from any instant of time in which it exists.</terms:description>
        <resource:subset>core</resource:subset>
        <resource:subset>process+</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">process</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000015 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000015">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000776"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000053"/>
                <owl:allValuesFrom rdf:resource="http://semanticscience.org/resource/SIO_000015"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>SIO_000015</dc:identifier>
        <terms:description xml:lang="en">information content entity is an object that requires some background knowledge or procedure to correctly interpret.</terms:description>
        <resource:subset>core</resource:subset>
        <resource:subset>ice+</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">information content entity</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000016 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000016">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000340"/>
        <dc:identifier>SIO_000016</dc:identifier>
        <terms:description xml:lang="en">A role is a realizable entity that describes behaviours, rights and obligations of an entity in some particular circumstance.</terms:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">role</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000027 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000027">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000005"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000218"/>
                <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/SIO_000006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>SIO_000027</dc:identifier>
        <terms:description xml:lang="en">A process quality is quality that is associated with a process.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">process quality</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000033 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000033">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000011"/>
                <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/SIO_000006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>SIO_000033</dc:identifier>
        <terms:description xml:lang="en">process status is a process quality that describes the state of a process.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">process status</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000035 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000035">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000033"/>
        <dc:identifier>SIO_000035</dc:identifier>
        <terms:description xml:lang="en">ongoing is the status of a process that is not yet complete.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">ongoing</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000052 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000052">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000257"/>
                    <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000258"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000070"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000011"/>
                <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/SIO_000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000215"/>
                <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/SIO_000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>SIO_000052</dc:identifier>
        <terms:description xml:lang="en">A quantity is an informational entity that gives the magnitude of a property.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">quantity</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000070 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000070">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000366"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000300"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000300"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000300"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000300"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000300"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <dc:identifier>SIO_000070</dc:identifier>
        <terms:description xml:lang="en">A measurement value is a quantitative description that reflects the magnitude of some attribute.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">measurement value</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000074 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000074">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000052"/>
        <dc:identifier>SIO_000074</dc:identifier>
        <terms:description xml:lang="en">A unit of measurement is a definite magnitude of a physical quantity, defined and adopted by convention and/or by law, that is used as a standard for measurement of the same physical quantity.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">unit of measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000075 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000075">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000015"/>
        <dc:identifier>SIO_000075</dc:identifier>
        <terms:description xml:lang="en">A mathematical entity is an information content entity that are components of a mathematical system or can be defined in mathematical terms.</terms:description>
        <resource:subset>math+</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">mathematical entity</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000078 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000078">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000015"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000300"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>SIO_000078</dc:identifier>
        <terms:description xml:lang="en">A language entity implements some language specification for the visual interpretation and is part of some document.</terms:description>
        <resource:subset>nlp+</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">language entity</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000108 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000108">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000078"/>
        <dc:identifier>SIO_000108</dc:identifier>
        <terms:description xml:lang="en">A character is a language symbol used to construct words.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">character</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000114 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000114">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000078"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000028"/>
                <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/SIO_001040"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000273"/>
                <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/SIO_000108"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>SIO_000114</dc:identifier>
        <terms:description xml:lang="en">A word is the smallest free form (an item that may be expressed in isolation with semantic or pragmatic content) in a language.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">word</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000133 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000133">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000275"/>
        <dc:identifier>SIO_000133</dc:identifier>
        <terms:description xml:lang="en">A descriptor (index term, subject term, subject heading) is a term that captures the essence of the topic of a document.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">descriptor</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000136 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000136">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000078"/>
        <dc:identifier>SIO_000136</dc:identifier>
        <terms:description xml:lang="en">A description is language entity in which elements of a language (formal or natural) are used to characterize an entity.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">description</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000257 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000257">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000052"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:complementOf>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000221"/>
                        <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/SIO_000074"/>
                    </owl:Restriction>
                </owl:complementOf>
            </owl:Class>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://semanticscience.org/resource/SIO_000258"/>
        <dc:identifier>SIO_000257</dc:identifier>
        <terms:description xml:lang="en">A dimensionless quantity is a quantity that has no associated unit.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">dimensionless quantity</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000258 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000258">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000052"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000221"/>
                <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/SIO_000074"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>SIO_000258</dc:identifier>
        <terms:description xml:lang="en">A dimensional quantity is a quantity that has an associated unit.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">dimensional quantity</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000275 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000275">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000078"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000114"/>
                    <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_000483"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <dc:identifier>SIO_000275</dc:identifier>
        <terms:description xml:lang="en">A term is a word or phrase used to denote one or more entities.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">term</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000340 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000340">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000614"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000643"/>
                <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/SIO_000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>SIO_000340</dc:identifier>
        <terms:description xml:lang="en">A realizable entity is an attribute that is exhibited under some condition and is realized in some process.</terms:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">realizable entity</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000366 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000366">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001431"/>
        <dc:identifier>SIO_000366</dc:identifier>
        <terms:alternative xml:lang="en">rank 0 tensor</terms:alternative>
        <terms:description xml:lang="en">A number is a tensor of rank 0.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">number</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000483 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000483">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000078"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000273"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://semanticscience.org/resource/SIO_000114"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>SIO_000483</dc:identifier>
        <terms:description xml:lang="en">A phrase is a group of words functioning as a single unit in the syntax of a sentence.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">phrase</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000614 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000614">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000011"/>
                <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/SIO_000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>SIO_000614</dc:identifier>
        <terms:description xml:lang="en">An attribute is a characteristic of some entity.</terms:description>
        <resource:subset>core</resource:subset>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">attribute</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000676 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000676">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000016"/>
        <dc:identifier>SIO_000676</dc:identifier>
        <terms:description xml:lang="en">A social role is a role that is ascribed to individuals in a community.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">social role</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000706 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000706">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000676"/>
        <dc:identifier>SIO_000706</dc:identifier>
        <terms:description xml:lang="en">An occupational role is a social role that pertains to an organizational structure.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">occupational role</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000726 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000726">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000706"/>
        <dc:identifier>SIO_000726</dc:identifier>
        <terms:description xml:lang="en">An administrative role is the role of an individual that performs administrative tasks for some organization.</terms:description>
        <rdfs:isDefinedBy rdf:resource="http://semanticscience.org/ontology/sio.owl"/>
        <rdfs:label xml:lang="en">administrative role</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/SIO_000776 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_000776">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000053"/>
                <owl:allValuesFrom rdf:resource="http://semanticscience.org/resource/SIO_000776"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>SIO_000776</dc:identifier>
