    <!-- http://purl.obolibrary.org/obo/DUO_0000010 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/DUO_0000010">
        <obo:DUO_0000041>is_restricted_to</obo:DUO_0000041>
        <obo:IAO_0000115>A is restricted to B iff A is a consent code and B is an investigation and A may only participate in instances of a class C, of which B is an instance.</obo:IAO_0000115>
        <obo:IAO_0000117>J. Neil Otte</obo:IAO_0000117>
        <obo:IAO_0000232>E.g. A dataset is restricted to an instance of an investigation for a specific disease or at geographical location.</obo:IAO_0000232>
        <oboInOwl:id>DUO:0000010</oboInOwl:id>
        <rdfs:label>is restricted to</rdfs:label>
    </owl:ObjectProperty>
    


