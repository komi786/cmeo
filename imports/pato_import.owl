        <owl:annotatedTarget>quality</owl:annotatedTarget>
        <oboInOwl:hasDbXref>OBO:legacy</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/PATO_0000051 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001241"/>
        <obo:IAO_0000115>A characterisitic of a single physical entity inhering in the bearer by virtue of the bearer&apos;s size or shape or structure.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0000051</oboInOwl:id>
