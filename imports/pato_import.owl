    <!-- http://purl.obolibrary.org/obo/PATO_0001241 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0001241">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000001"/>
        <obo:IAO_0000115>A characteristic which inheres in a continuant.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>PATO:0001237</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>PATO:0001238</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>monadic quality of a continuant</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>multiply inhering quality of a physical entity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>physical object quality</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>quality of a continuant</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>quality of a single physical entity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>quality of an object</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>quality of continuant</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>monadic quality of an object</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>monadic quality of continuant</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0001241</oboInOwl:id>
        <rdfs:comment>Relational characteristics are characteristics that hold between multiple entities. Normal (monadic) characteristics such as the shape of a eyeball exist purely as a characteristic of that eyeball. A relational characteristic such as sensitivity to light is a characteristic of that eyeball (and connecting nervous system) as it relates to incoming light waves/particles.</rdfs:comment>
        <rdfs:label>physical object characteristic</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0001241"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>physical object quality</owl:annotatedTarget>
        <oboInOwl:hasDbXref>OBO:legacy</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0001241"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A characteristic which inheres in a continuant.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PATOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    


