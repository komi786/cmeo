    <!-- http://purl.obolibrary.org/obo/PATO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PATO_0000001">
        <obo:IAO_0000115>The properties, attributes, or modifiers used to describe an entity or process or some aspect of an entity or process.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>PATO:0000072</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>quality</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>quality</oboInOwl:hasOBONamespace>
        <oboInOwl:id>PATO:0000001</oboInOwl:id>
        <rdfs:label>characteristic</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/PATO_0000001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The properties, attributes, or modifiers used to describe an entity or process or some aspect of an entity or process.</owl:annotatedTarget>
