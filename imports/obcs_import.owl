        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0200000"/>
        <obo:IAO_0000115>A data transformation that has input of mulitple data and report overall trend of the data.</obo:IAO_0000115>
        <obo:IAO_0000117>Jie Zheng, Oliver He</obo:IAO_0000117>
        <obo:IAO_0000119>WEB: https://en.wikipedia.org/wiki/Statistics</obo:IAO_0000119>
