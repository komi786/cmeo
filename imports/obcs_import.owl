    <!-- http://purl.obolibrary.org/obo/OBCS_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBCS_0000002">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000417"/>
