        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <obo:IAO_0000115>A data item that is more specifically a rectangular array of numbers, symbols, or expressions, arranged in rows and columns.</obo:IAO_0000115>
        <obo:IAO_0000117>Person: Oliver He, Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">set of data sets</obo:IAO_0000118>
        <obo:IAO_0000119>WEB: https://en.wikipedia.org/wiki/Matrix_(mathematics)</obo:IAO_0000119>
        <rdfs:label>data matrix</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBCS_0000121 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBCS_0000121">
        <owl:equivalentClass>
