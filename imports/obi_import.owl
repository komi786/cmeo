        <obo:IAO_0000234>NCI BBRB</obo:IAO_0000234>
        <rdfs:label>pT3 (colon)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002230 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OBI_0002230">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/OBI_0002224"/>
        <obo:IAO_0000111>pT4a (colon)</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">A pathologic primary tumor stage for colon and rectum according to AJCC 7th edition indicating that the tumor perforates visceral peritoneum.</obo:IAO_0000115>
        <obo:IAO_0000117>Chris Stoeckert, Helena Ellis</obo:IAO_0000117>
