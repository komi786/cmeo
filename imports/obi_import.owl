        <obo:IAO_0000115 xml:lang="en">A categorical value specification that is a histologic grade assigned to a tumor slide specimen according to the Fuhrman Nuclear Grading System.</obo:IAO_0000115>
        <obo:IAO_0000117>Chris Stoeckert, Helena Ellis</obo:IAO_0000117>
        <obo:IAO_0000118>Histologic Grade (Fuhrman Nuclear Grading System)</obo:IAO_0000118>
        <obo:IAO_0000119>NCI BBRB, OBI</obo:IAO_0000119>
