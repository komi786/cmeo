        <obo:IAO_0000115 xml:lang="en">This relation obtains between an objective specification and a planned process when the criteria specified in the objective specification are met at the end of the planned process.</obo:IAO_0000115>
        <obo:IAO_0000117>OBI</obo:IAO_0000117>
        <obo:IAO_0000119>OBI</obo:IAO_0000119>
