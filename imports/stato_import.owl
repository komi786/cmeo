        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">y-axis is a cartesian coordinate axis which is orthogonal to the x-axis and the z-axis</obo:IAO_0000115>
        <obo:IAO_0000117>Alejandra Gonzalez-Beltran</obo:IAO_0000117>
