    <!-- http://purl.obolibrary.org/obo/CMEO_0000084 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/CMEO_0000084">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <w3id:IAO_0000115 xml:lang="en">Relates an information content entity (a record or variable) to the occurrent (e.g. a process or event) whose occurrence it documents. A more specific form of &apos;is about&apos; for records of occurrents.</w3id:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/cmeo.owl"/>
        <rdfs:label xml:lang="en">is record of</rdfs:label>
    </owl:ObjectProperty>
    


