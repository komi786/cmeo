        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000100"/>
        <w3id:IAO_0000115 xml:lang="en">A homogeneous data collection whose member measurement data are collected over time according to a study protocol that has a timeline specification, so that observations are associated with visits or timepoints.</w3id:IAO_0000115>
        <oboInOwl:id rdf:resource="http://purl.obolibrary.org/obo/CMEO_0000077"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/cmeo.owl"/>
        <rdfs:label xml:lang="en">temporal dataset</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMEO_0000078 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMEO_0000078">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <w3id:IAO_0000115 xml:lang="en">An information content entity that specifies what actions are permitted for a given agent (or role) over a specified resource, under stated conditions and constraints.</w3id:IAO_0000115>
        <oboInOwl:id rdf:resource="http://purl.obolibrary.org/obo/CMEO_0000078"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/cmeo.owl"/>
        <rdfs:label xml:lang="en">permission specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMEO_0000079 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMEO_0000079">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000035"/>
        <w3id:IAO_0000115 xml:lang="en">A planned process in which an agent obtains access to a data resource, resulting in the ability to view, retrieve, query, or otherwise use the data; such access may be governed by specified permissions and constraints.</w3id:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/cmeo.owl"/>
        <rdfs:label xml:lang="en">data access</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMEO_0000081 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMEO_0000081">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000582"/>
        <w3id:IAO_0000115 xml:lang="en">A time stamped measurement datum that records the length of the time interval over which a participant or entity is observed or followed up in a study (e.g., total follow-up time).</w3id:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/cmeo.owl"/>
        <rdfs:label xml:lang="en">duration of observation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/EUPATH_0000138"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CMEO_0000083 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CMEO_0000083">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CMEO_0000063"/>
        <w3id:IAO_0000115 xml:lang="en">A clinical endpoint specification that defines a primary or secondary endpoint as a combination of two or more distinct component outcomes, assessed jointly to evaluate a research hypothesis in a clinical study.</w3id:IAO_0000115>
        <rdfs:label xml:lang="en">composite endpoint specification</rdfs:label>
    </owl:Class>
    


