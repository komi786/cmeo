    <!-- http://purl.obolibrary.org/obo/CMEO_0000085 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/CMEO_0000085">
        <rdfs:comment xml:lang="en">Groups CMEO and imported terms by kind of clinical data (measurement, record, observation, identifier, visit type, clinical finding) for annotation, search and harmonization</rdfs:comment>
        <rdfs:label xml:lang="en">clinical data category subset</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#SubsetProperty"/>
    </owl:AnnotationProperty>
    


