    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OGMS_0000014">
        <w3id:IAO_0000115 xml:lang="en">A representation that is either the output of a clinical history taking or a physical examination or an image finding, or some combination thereof. A clinical statement about an organism that is the result of clinical observation or assessment, including observed signs, reported symptoms, and clinician-asserted findings.</w3id:IAO_0000115>
