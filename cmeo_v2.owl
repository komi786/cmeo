    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCIT_C103165">
        <w3id:IAO_0000115 xml:lang="en">The kind of visit undertaken by the subject within a study, such as inpatient, outpatient, telephone, etc.</w3id:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/CMEO_0000085"/>
        <rdfs:label xml:lang="en">visit type</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0003071">
        <w3id:IAO_0000115 xml:lang="en">A symbol that denotes a participant under investigation.</w3id:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/CMEO_0000085"/>
        <rdfs:label>participant identifier</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SCDO_1000849">
        <w3id:IAO_0000115 xml:lang="en">A clinical visit occuring because of an acute (severe with sudden onset) health condition.</w3id:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/CMEO_0000085"/>
        <rdfs:label xml:lang="en">acute clinical visit</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SCDO_1000900">
        <w3id:IAO_0000115 xml:lang="en">A clinical visit that is the patient&apos;s first clinical visit.</w3id:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/CMEO_0000085"/>
        <rdfs:label xml:lang="en">baseline visit</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SCDO_1000901">
        <w3id:IAO_0000115 xml:lang="en">A clinical visit that is a follow-up for a previous visit.</w3id:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/CMEO_0000085"/>
        <rdfs:label xml:lang="en">follow-up</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/SYMP_0000462">
        <w3id:IAO_0000115 xml:lang="en">A symptom is a perceived change in function, sensation, loss, disturbance or appearance reported by a patient indicative of a disease.</w3id:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/CMEO_0000085"/>
        <rdfs:label xml:lang="en">symptom</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_010060">
        <w3id:IAO_0000115 xml:lang="en">A medical history that records health-relevant conditions, events, or traits occurring in the biological relatives of a patient.</w3id:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/CMEO_0000085"/>
        <rdfs:label xml:lang="en">family history</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://semanticscience.org/resource/SIO_010673">
        <w3id:IAO_0000115 xml:lang="en">A medical history is a record of the events of a recipient of medical care.</w3id:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/CMEO_0000085"/>
        <rdfs:label xml:lang="en">medical history</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.ebi.ac.uk/efo/EFO_0004302">
        <w3id:IAO_0000115 xml:lang="en">Anthropometry is a measurement of the size, weight, and proportions of the human or other primate body.</w3id:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/CMEO_0000085"/>
        <rdfs:label xml:lang="en">anthropometric measurement</rdfs:label>
    </rdf:Description>
    


